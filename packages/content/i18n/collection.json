  "get.level": { "en": "Reach level {n}. You are level {now} now, and every game, lesson and puzzle helps.", "zh": "达到 {n} 级。你现在是 {now} 级，每盘棋、每节课、每道谜题都有帮助。", "hi": "लेवल {n} तक पहुँचें। आप अभी लेवल {now} पर हैं, और हर खेल, पाठ और पहेली मदद करती है।", "es": "Llega al nivel {n}. Ahora estás en el nivel {now}, y cada partida, lección y problema te ayuda.", "fr": "Atteins le niveau {n}. Tu es au niveau {now}, et chaque partie, leçon et problème t'aide à avancer.", "ar": "صِل إلى المستوى {n}. أنت الآن في المستوى {now}، وكل مباراة ودرس ولغز يساعدك.", "bn": "লেভেল {n}-এ পৌঁছাও। তুমি এখন লেভেল {now}-এ আছ, আর প্রতিটা খেলা, পাঠ আর ধাঁধা তোমাকে এগিয়ে দেয়।", "pt": "Chegue ao nível {n}. Agora você está no nível {now}, e cada partida, lição e problema ajuda.", "ru": "Достигни уровня {n}. Сейчас у тебя уровень {now}, и каждая партия, урок и задача помогают.", "ur": "لیول {n} تک پہنچو۔ ابھی تم لیول {now} پر ہو، اور ہر کھیل، سبق اور پہیلی مدد کرتی ہے۔", "check": ["zh", "hi", "es", "fr", "ar", "bn", "pt", "ru", "ur"] },
  "get.badge": { "en": "Earn the {name} badge: {desc}", "zh": "赢得 {name} 徽章：{desc}", "hi": "{name} बैज जीतें: {desc}", "es": "Gana la insignia {name}: {desc}", "fr": "Gagne le badge {name} : {desc}", "ar": "اربح شارة {name}: {desc}", "bn": "{name} ব্যাজটা জেতো: {desc}", "pt": "Ganhe a medalha {name}: {desc}", "ru": "Заслужи значок «{name}»: {desc}", "ur": "{name} کا بیج جیتو: {desc}", "check": ["zh", "hi", "es", "fr", "ar", "bn", "pt", "ru", "ur"] },
  "get.journey": { "en": "Beat {coach}, the champion of {era}, on The Journey.", "zh": "在“旅程”中打败 {era} 的冠军 {coach}。", "hi": "सफ़र में {era} के चैंपियन {coach} को हराएँ।", "es": "Vence a {coach}, campeón de {era}, en El Viaje.", "fr": "Bats {coach}, le champion de l'époque {era}, dans Le Voyage.", "ar": "اهزم {coach}، بطل {era}، في «الرحلة».", "bn": "যাত্রায় {era}-এর চ্যাম্পিয়ন {coach}-কে হারাও।", "pt": "Vença {coach}, o campeão de {era}, na Jornada.", "ru": "Победи {coach}, чемпиона эпохи «{era}», в Путешествии.", "ur": "سفر میں {era} کے چیمپئن {coach} کو ہراؤ۔", "check": ["zh", "hi", "es", "fr", "ar", "bn", "pt", "ru", "ur"] },
  "get.season": { "en": "Reach tier {n} of the season. Missions and games move you up.", "zh": "达到本赛季第 {n} 阶。完成任务和下棋都能让你升阶。", "hi": "सीज़न के टियर {n} तक पहुँचें। मिशन और खेल आपको ऊपर ले जाते हैं।", "es": "Llega al escalón {n} de la temporada. Las misiones y las partidas te hacen subir.", "fr": "Atteins le palier {n} de la saison. Les missions et les parties te font monter.", "ar": "صِل إلى الدرجة {n} من الموسم. المهمات والمباريات ترفعك.", "bn": "সিজনের ধাপ {n}-এ পৌঁছাও। মিশন আর খেলা তোমাকে ওপরে তোলে।", "pt": "Chegue à faixa {n} da temporada. Missões e partidas fazem você subir.", "ru": "Достигни ступени {n} в сезоне. Задания и партии поднимают тебя выше.", "ur": "سیزن کے درجہ {n} تک پہنچو۔ مشن اور کھیل تمہیں آگے بڑھاتے ہیں۔", "check": ["zh", "hi", "es", "fr", "ar", "bn", "pt", "ru", "ur"] },
  "get.seasonPass": { "en": "Reach tier {n} of the season with the Season Pass. Missions and games move you up.", "zh": "用赛季通行证达到本赛季第 {n} 阶。完成任务和下棋都能让你升阶。", "hi": "सीज़न पास के साथ सीज़न के टियर {n} तक पहुँचें। मिशन और खेल आपको ऊपर ले जाते हैं।", "es": "Llega al escalón {n} de la temporada con el Pase de Temporada. Las misiones y las partidas te hacen subir.", "fr": "Atteins le palier {n} de la saison avec le Pass de saison. Les missions et les parties te font monter.", "ar": "صِل إلى الدرجة {n} من الموسم مع تذكرة الموسم. المهمات والمباريات ترفعك.", "bn": "সিজন পাস নিয়ে সিজনের ধাপ {n}-এ পৌঁছাও। মিশন আর খেলা তোমাকে ওপরে তোলে।", "pt": "Chegue à faixa {n} da temporada com o Passe da Temporada. Missões e partidas fazem você subir.", "ru": "Достигни ступени {n} в сезоне с Сезонным пропуском. Задания и партии поднимают тебя выше.", "ur": "سیزن پاس کے ساتھ سیزن کے درجہ {n} تک پہنچو۔ مشن اور کھیل تمہیں آگے بڑھاتے ہیں۔", "check": ["zh", "hi", "es", "fr", "ar", "bn", "pt", "ru", "ur"] },
