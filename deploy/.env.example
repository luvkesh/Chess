# Copy to .env and fill in. Never commit .env.

# The public address players use. Email links point here.
CHACKLATE_DOMAIN=chess.example.com
CHACKLATE_PUBLIC_URL=https://chess.example.com

# First admin for /admin, created only when the staff table is empty. Change the password after signing in.
CHACKLATE_ADMIN_EMAIL=
CHACKLATE_ADMIN_PASSWORD=

# Email: log (prints instead of sending) or http (Resend-compatible API).
CHACKLATE_MAIL=log
CHACKLATE_MAIL_URL=https://api.resend.com/emails
CHACKLATE_MAIL_KEY=
CHACKLATE_MAIL_FROM=Chacklate Chess <no-reply@chess.example.com>

# Payments: off (store closed), dev (no money moves; never in production) or external.
CHACKLATE_PAYMENTS=off
CHACKLATE_CHECKOUT_URL=
CHACKLATE_PAYMENT_SECRET=

# Web Push: leave the keys empty to generate them once and keep them in the database.
CHACKLATE_PUSH_SUBJECT=mailto:support@chess.example.com
CHACKLATE_VAPID_PUBLIC=
CHACKLATE_VAPID_PRIVATE=
